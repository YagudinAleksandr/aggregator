.idea/
*.iml
*.ipr
*.iws
out/
# ...но не пакеты с именем out в исходниках (например adapters/out)
!**/src/main/**/out/
!**/src/test/**/out/

# ---------- IDE: VS Code ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.code-workspace

# ---------- IDE: Eclipse / STS / NetBeans ----------
